# ============================================================
# FlowNiaga — contoh konfigurasi environment
# Salin menjadi `.env` lalu sesuaikan. JANGAN commit file .env.
# ============================================================

# --- Branding (nama kerja; ganti tanpa mengubah kode) ---
APP_NAME=FlowNiaga
NEXT_PUBLIC_APP_NAME=FlowNiaga

# --- Database ---
DATABASE_URL=postgresql://flowniaga:flowniaga@localhost:5432/flowniaga?schema=public
# Dipakai oleh integration test (database terpisah, akan di-reset!)
DATABASE_URL_TEST=postgresql://flowniaga:flowniaga@localhost:5432/flowniaga_test?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
# WAJIB diganti di production (minimal 32 karakter acak)
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-32ch
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-32c
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
# Deployment same-origin (opsional): set keduanya agar web memproksikan API.
# NEXT_PUBLIC_API_URL=/api/backend
# API_PROXY_TARGET=http://localhost:3001
# Bila memakai proxy, set juga di API: REFRESH_COOKIE_PATH=/api/backend/auth

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Seed demo (hanya boleh true di local development) ---
SEED_DEMO_DATA=true
