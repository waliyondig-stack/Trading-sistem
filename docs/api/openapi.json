  "info": {
    "title": "FlowNiaga API",
    "description": "API FlowNiaga — Sistem Operasi Bisnis Omnichannel. Endpoint tenant-scoped membutuhkan header x-tenant-id.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "pemilik@tokosaya.id"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "RahasiaKuat123"
          },
          "name": {
            "type": "string",
            "example": "Budi Santoso"
          },
          "tenantName": {
            "type": "string",
            "example": "Toko Saya",
            "description": "Nama usaha/tenant yang dibuat"
          },
          "tenantSlug": {
            "type": "string",
            "example": "toko-saya",
            "description": "Slug unik tenant (huruf kecil, angka, tanda hubung)"
          }
        },
        "required": ["email", "password", "name", "tenantName", "tenantSlug"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "owner@demo.flowniaga.local"
          },
          "password": {
            "type": "string",
            "example": "Demo1234!"
          }
        },
        "required": ["email", "password"]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": ["refreshToken"]
      },
      "UpdateTenantDto": {
        "type": "object",
        "properties": {}
      },
      "CreateBranchDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "JKT-01",
            "description": "Kode unik cabang dalam tenant"
          },
          "name": {
            "type": "string",
            "example": "Cabang Jakarta Pusat"
          },
          "address": {
            "type": "string",
            "example": "Jl. Sudirman No. 1, Jakarta"
          },
          "phone": {
            "type": "string",
            "example": "+62215550001"
          }
        },
        "required": ["code", "name"]
      },
      "UpdateBranchDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      },
      "CreateWarehouseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "WH-JKT-01"
          },
          "name": {
            "type": "string",
            "example": "Gudang Utama Jakarta"
          },
          "branchId": {
            "type": "string",
            "description": "ID cabang pemilik gudang"
          },
          "address": {
            "type": "string"
          }
        },
        "required": ["code", "name", "branchId"]
      },
      "UpdateWarehouseDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "InviteMemberDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "kasir@tokosaya.id"
          },
          "roleId": {
            "type": "string",
            "description": "ID role tenant yang diberikan"
          },
          "name": {
            "type": "string",
            "description": "Nama (wajib bila user belum terdaftar)"
          },
          "initialPassword": {
            "type": "string",
            "description": "Kata sandi awal (wajib bila user belum terdaftar)"
          },
